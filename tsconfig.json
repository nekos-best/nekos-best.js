{
    "compilerOptions": {
        "alwaysStrict": true,
        "declaration": true,
        "declarationMap": true,
        "forceConsistentCasingInFileNames": true,
        "module": "NodeNext",
        "outDir": "dist",
        "moduleResolution": "nodenext",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "noImplicitOverride": true,
    },
}
