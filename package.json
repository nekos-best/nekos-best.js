{
    "name": "nekos-best.js",
    "version": "7.0.0",
    "author": "Thund (https://github.com/thund-x)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nekos-best/nekos-best.js.git"
    },
    "devDependencies": {
        "@types/node": "^24.10.3",
        "typedoc": "^0.28.19",
        "typedoc-github-theme": "^0.4.0",
        "typescript": "^5.9.3"
    },
    "exports": {
        "./constants.js": {
            "types": "./dist/constants.d.ts",
            "import": "./dist/constants.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "bugs": "https://github.com/nekos-best/nekos-best.js/issues",
    "contributors": [
        "Thusuzzee (https://github.com/Thusuzzee)",
        "oriel-beck (https://github.com/oriel-beck)"
    ],
    "description": "The official JavaScript wrapper for the https://nekos.best API with TypeScript typings.",
    "engines": {
        "node": ">=24.15.0"
    },
    "files": [
        "LICENSE",
        "CHANGELOG.md",
        "README.md",
        "dist"
    ],
    "keywords": [
        "api",
        "neko",
        "nekos",
        "roleplay",
        "rp",
        "wrapper"
    ],
    "license": "MIT",
    "private": true,
    "scripts": {
        "build": "tsc",
        "build:docs": "typedoc",
        "prepack": "bun run build"
    },
    "type": "module"
}
